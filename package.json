{
  "name": "rawstate-idb",
  "version": "1.0.0",
  "description": "Saves a rawstate store to IndexedDB, loads it at start and keeps browser tabs in sync. Atomic writes, versions and migrations. About 3 KB gzipped.",
  "keywords": [
    "indexeddb",
    "persistence",
    "offline",
    "cache",
    "state",
    "store",
    "local-first",
    "broadcastchannel",
    "migrations",
    "rawstate",
    "typescript"
  ],
  "homepage": "https://github.com/selbstnull/rawstate-idb#readme",
  "bugs": {
    "url": "https://github.com/selbstnull/rawstate-idb/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/selbstnull/rawstate-idb.git"
  },
  "license": "Apache-2.0",
  "author": "nullselbst",
  "sideEffects": false,
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit && jest",
    "prepublishOnly": "npm test && npm run build"
  },
  "peerDependencies": {
    "rawstate": "^1.0.0"
  },
  "devDependencies": {
    "@types/jest": "^30",
    "fake-indexeddb": "^6",
    "rawstate": "link:../rawstate-core",
    "jest": "^30",
    "ts-jest": "^29",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "zod": "^4.6.7"
  }
}
